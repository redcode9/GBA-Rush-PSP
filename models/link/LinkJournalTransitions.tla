JournalRoles == {"HOST", "JOINER", "EITHER"}

JournalTransitionTable == {
  [name |-> "arm", from |-> "EMPTY", to |-> "ARMED", role |-> "EITHER", trigger |-> "LOCAL_ARM", flags |-> {"ADMISSION", "CANCELABLE"}],
