  [name |-> "record_decision", from |-> "ARMED", to |-> "DECIDED", role |-> "JOINER", trigger |-> "DECISION", flags |-> {"IMMUTABLE_HASH"}],
  [name |-> "replay_decision", from |-> "DECIDED", to |-> "DECIDED", role |-> "EITHER", trigger |-> "DECISION", flags |-> {"IDEMPOTENT", "IMMUTABLE_HASH"}],
  [name |-> "mark_released", from |-> "DECIDED", to |-> "RELEASED", role |-> "HOST", trigger |-> "DECISION_ACK", flags |-> {"IDEMPOTENT"}],
  [name |-> "record_release", from |-> "DECIDED", to |-> "RELEASED", role |-> "JOINER", trigger |-> "RELEASE", flags |-> {"IDEMPOTENT"}],
  [name |-> "replay_release", from |-> "RELEASED", to |-> "RELEASED", role |-> "EITHER", trigger |-> "RELEASE", flags |-> {"IDEMPOTENT"}],
  [name |-> "clear_released", from |-> "RELEASED", to |-> "EMPTY", role |-> "EITHER", trigger |-> "RELEASE_SHARED", flags |-> {"CHECKPOINT"}],
  [name |-> "recover_cancel_arm", from |-> "ARMED", to |-> "EMPTY", role |-> "EITHER", trigger |-> "RECOVERY_EMPTY", flags |-> {"RECOVERY_SAFE"}],
  [name |-> "recover_decision", from |-> "ARMED", to |-> "DECIDED", role |-> "JOINER", trigger |-> "RECOVERY_DECISION", flags |-> {"IMMUTABLE_HASH", "RECOVERY_SAFE"}],
  [name |-> "recover_release", from |-> "DECIDED", to |-> "RELEASED", role |-> "EITHER", trigger |-> "RECOVERY_RELEASE", flags |-> {"IDEMPOTENT", "RECOVERY_SAFE"}],
  [name |-> "recover_empty", from |-> "EMPTY", to |-> "EMPTY", role |-> "EITHER", trigger |-> "RECOVERY_CHECKPOINT", flags |-> {"IDEMPOTENT", "CHECKPOINT", "RECOVERY_SAFE"}],
  [name |-> "recover_released", from |-> "RELEASED", to |-> "EMPTY", role |-> "EITHER", trigger |-> "RECOVERY_CHECKPOINT", flags |-> {"IDEMPOTENT", "CHECKPOINT", "RECOVERY_SAFE"}]
